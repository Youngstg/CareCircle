# Copy to .env for Docker Compose. Replace every CHANGE_ME value before production.
MYSQL_DATABASE=carecircle
MYSQL_USER=carecircle
MYSQL_PASSWORD=CHANGE_ME_dev_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_dev_mysql_root_password
DATABASE_URL=mysql://carecircle:CHANGE_ME_dev_mysql_password@db:3306/carecircle

BETTER_AUTH_SECRET=CHANGE_ME_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000

# Private S3-compatible document storage (10 MB application limit).
# Containers always receive http://minio:9000 from docker-compose.yml.
# A host-run app (for example with Laragon MySQL) should use http://127.0.0.1:9000.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=carecircle-documents
MINIO_ACCESS_KEY=CHANGE_ME_dev_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_dev_minio_secret_key_at_least_8_chars
MINIO_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
